<service>
  <id>WorkBridgeMCP</id>
  <name>WorkBridgeMCP</name>
  <description>Local Workstation Bridge MCP server</description>

  <!-- Replace at packaging/install time. -->
  <executable>%WORKBRIDGE_BINARY%</executable>
  <arguments>%WORKBRIDGE_ARGUMENTS%</arguments>
  <workingdirectory>%WORKBRIDGE_WORKING_DIRECTORY%</workingdirectory>

  <!-- Do not embed secrets in this file. -->
  <logpath>%WORKBRIDGE_LOG_DIRECTORY%</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>

  <onfailure action="restart" delay="5 sec" />
  <stoptimeout>30 sec</stoptimeout>
</service>
